{
  "name": "easyeda-harness",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "npm ci && npm run doctor:offline",
    "doctor": "node scripts/doctor.mjs",
    "doctor:offline": "node scripts/doctor.mjs --offline",
    "bridge": "node scripts/start-bridge.mjs",
    "evidence:init": "node scripts/init-evidence.mjs",
    "wf": "node wf.mjs",
    "compile": "node compile.mjs",
    "audit:generic": "node engine/rubric_audit.mjs",
    "ci": "npm run doctor:offline && npm test && npm run audit:generic",
    "test": "node --test circuit_packs/archetypes/*.test.mjs engine/*.test.mjs",
    "layout": "node bin/plexus.mjs layout",
    "deliver": "node bin/plexus.mjs deliver",
		"pcb:snapshot": "node bin/plexus.mjs pcb-snapshot",
		"pcb:qc": "node bin/plexus.mjs pcb-qc",
		"pcb:judge": "node bin/plexus.mjs pcb-judge-live",
    "live:save": "node engine/bridge_exec.mjs --js snapshot2.js --out live.json",
    "live:image": "node engine/bridge_exec.mjs --js snapshot-image.js --out live_canvas.png --mode image"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "elkjs": "^0.11.1"
  }
}
